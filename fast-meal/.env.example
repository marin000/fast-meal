# Backend API URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional — set to "true" to test fridge expiration notifications
# EXPO_PUBLIC_TEST_EXPIRATION_NOTIFICATIONS=true

# Sentry (create projects at https://sentry.io — org/project must match app.json plugin)
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
# EXPO_PUBLIC_SENTRY_AUTH_TOKEN=<org-auth-token-for-sourcemap-upload>
# Also set SENTRY_AUTH_TOKEN as an EAS secret for production builds.
