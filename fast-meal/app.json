{
	"expo": {
		"name": "FastMeal",
		"slug": "fast-meal",
		"version": "1.3.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "fastmeal",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"buildNumber": "7",
			"infoPlist": {
				"NSCameraUsageDescription": "FastMeal uses the camera so you can photograph ingredients, scan product barcodes, or photograph your fridge.",
				"NSPhotoLibraryUsageDescription": "FastMeal accesses your photos so you can upload a picture of ingredients or your fridge."
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#2D8A4E",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.marin1997.fastmeal",
			"versionCode": 7
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"./plugins/with-async-storage-local-maven",
			"./plugins/with-android-gradle-memory-lint",
			"./plugins/with-android-node-binary-for-gradle",
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#2D8A4E",
					"dark": {
						"backgroundColor": "#2D8A4E"
					}
				}
			],
			"expo-localization",
			"@react-native-community/datetimepicker",
			[
				"expo-notifications",
				{
					"icon": "./assets/images/icon.png",
					"color": "#2D8A4E"
				}
			],
			[
				"expo-navigation-bar",
				{
					"enforceContrast": false,
					"hidden": true
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "FastMeal accesses your photos so you can upload a picture of ingredients or your fridge.",
					"cameraPermission": "FastMeal uses the camera so you can photograph ingredients or your fridge."
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "FastMeal uses the camera so you can photograph ingredients, scan product barcodes, or photograph your fridge.",
					"microphonePermission": false,
					"recordAudioAndroid": false
				}
			],
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"note": "Use SENTRY_AUTH_TOKEN env to authenticate with Sentry.",
					"organization": "fast-meal",
					"project": "fast-meal"
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "d9553ee5-30e8-4b36-bdc1-d857e23e3ceb"
			}
		}
	}
}
