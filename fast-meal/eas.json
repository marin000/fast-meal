{
	"cli": {
		"version": ">= 18.11.0",
		"appVersionSource": "remote",
		"promptToConfigurePushNotifications": false
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"channel": "preview",
			"distribution": "internal"
		},
		"production": {
			"channel": "production",
			"autoIncrement": true,
			"distribution": "store",
			"environment": "production",
			"android": {
				"buildType": "app-bundle"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "production"
			},
			"ios": {
				"ascAppId": "6820716536"
			}
		}
	}
}
